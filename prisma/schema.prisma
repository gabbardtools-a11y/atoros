// Prisma schema for Atoros.ru Copyright Deposit Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  middleName   String?
  lastName     String
  phone        String?
  country      String        @default("RU")
  city         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  certificates Certificate[]
}

model Certificate {
  id            String   @id @default(cuid())

  // Public URL slug: e.g. "1_20260902" (sequence per day + YYYYMMDD)
  // First cert today = 1_20260902, second = 2_20260902, etc.
  slug          String   @unique

  // Legacy cert number for display: e.g. "2026-001" (year-seq, kept for backward compat)
  certNumber    String   @unique
  certYear      Int
  certSeq       Int

  // Work metadata
  workTitle     String
  workType      String   // text, image, audio, video, code, collection, other
  description   String?
  coAuthors     String?  // comma-separated names

  // Archive file info
  archiveName    String   // e.g. "20260902_1.zip" (YYYYMMDD_N.zip)
  archiveSize    Int      // bytes
  archivePath    String   // server path under /uploads
  fileCount      Int      @default(1) // number of files inside the archive

  // Hashes of the archive
  md5Hash        String   // hex MD5 of archive bytes
  sha256Hash     String   // hex SHA-256 of archive bytes

  // Archive password (auto-generated 12 chars, only visible to author in dashboard)
  archivePassword String  // plain-text 12-char password, AES-256 encrypted ZIP

  // Author snapshot at moment of deposit (denormalized for certificate stability)
  authorFirstName String
  authorMiddleName String?
  authorLastName  String
  authorCountry   String
  authorEmail     String
  authorPhone     String?
  authorCity      String?

  // Relations
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Status
  status        String   @default("published") // published | pending | rejected

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId])
  @@index([certYear, certSeq])
  @@index([slug])
}
